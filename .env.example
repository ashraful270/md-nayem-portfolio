# ==============================================================================
# MD NAYEM HOSSAIN — 3D Artist & EEE Engineer Portfolio & CMS
# Production Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Phase 2 — MongoDB Atlas Persistence)
# ------------------------------------------------------------------------------
# In production, provide your MongoDB Atlas connection string.
# MongoDB Atlas provides persistent, resilient cloud document storage for 500+ projects.
# When MONGODB_URI is provided, the application connects to MongoDB Atlas.
# In local development without MONGODB_URI, the app falls back to local data/db.json.
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://admin_user:YOUR_SECURE_PASSWORD@cluster0.mongodb.net/nayem_portfolio?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS (Phase 4 — Hardening)
# ------------------------------------------------------------------------------
# Secret key used for cryptographically signing Admin JWT session tokens (HMAC SHA-256).
# IMPORTANT: In production, generate a random 256-bit string (e.g. openssl rand -hex 32).
# Do NOT leave this as the default placeholder in production.
JWT_SECRET="generate-a-strong-random-hex-secret-for-production-jwt-signing"

# Default Admin credentials used to initialize or reset the admin CMS account.
# If ADMIN_PASSWORD is set, the administrator can initialize/reset their credentials.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChooseAStrongAdminPassword2026!"

# ------------------------------------------------------------------------------
# 3. CLOUD MEDIA & ASSET STORAGE (Phase 3 — Object Storage)
# ------------------------------------------------------------------------------
# Ephemeral containers (Cloud Run, Render, Railway, Vercel) lose local disk files on restart.
# Configure persistent cloud media storage for 3D models (GLB/GLTF), videos, and 4K renders.

# Option A: Cloudinary (Recommended for image transforms, auto-WebP, 4K renders & GLB models)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
# Alternatively, single URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Option B: AWS S3 / Cloudflare R2 / MinIO (Object Storage)
STORAGE_PROVIDER="cloudinary" # Options: 'cloudinary' | 's3' | 'local'
S3_BUCKET="nayem-portfolio-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com" # For Cloudflare R2 / MinIO
# S3_PUBLIC_DOMAIN="https://media.nayemhossain3d.com"

# ------------------------------------------------------------------------------
# 4. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development" # Set to 'production' for live deployments
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
